<?xml version="1.0" encoding="utf-8"?>
<!-- Pin the package source so `dotnet restore` is hermetic regardless of machine-level NuGet config
     (a dev machine with no user-level sources otherwise fails the test-project restore with NU1100). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
